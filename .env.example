# Public backend origin, without /api. Vite includes this value in browser assets.
# Locally, run the backend separately at this address.
VITE_API_URL=http://127.0.0.1:3001

# In Vercel, use your Render backend's public URL instead:
# VITE_API_URL=https://portfolio-api.onrender.com
# Never put Gemini/Pinecone keys in this repository or any VITE_ variable.

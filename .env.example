# Server-only credentials. Never prefix these with VITE_.
GEMINI_API_KEY=
PINECONE_API_KEY=

# Index NAME, not its https://...pinecone.io host URL.
# An existing index must match EMBEDDING_DIMENSIONS and use cosine similarity.
PINECONE_INDEX=portfolio
# Exact namespace containing your existing records; no document hash is appended.
PINECONE_NAMESPACE=__default__
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072
RAG_MIN_SCORE=0.5

# Defaults: localhost in development, 0.0.0.0 in production.
# On Render, set HOST=0.0.0.0 if overriding it and let Render supply PORT.
# HOST=127.0.0.1
# PORT=3001
TRUST_PROXY_HOPS=0
